<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> - CMS Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="logo">CMS<span>Blog</span></div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/posts/new" class="nav-create">+ Create Post</a>
        </div>
    </nav>

    <main class="container">
        <article class="single-post">
            <h1><%= post.title %></h1>
            <div class="post-meta">
                By <strong><%= post.author %></strong> • Published on <%= new Date(post.createdAt).toLocaleDateString() %>
            </div>
            <div class="content"><%= post.content %></div>
            <div class="actions">
                <a href="/" class="btn btn-secondary">← Back to Posts</a>
            </div>
        </article>
    </main>

    <footer class="footer">© 2026 CMS Blog • Built with Node.js, Express, EJS & MongoDB</footer>
</body>
</html>
