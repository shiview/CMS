<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Post - CMS Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="logo">CMS<span>Blog</span></div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/posts/new" class="nav-create">+ Create Post</a>
        </div>
    </nav>

    <main class="container">
        <div class="form-card">
            <span class="eyebrow" style="background:#eef0ff;color:#5b5cf0;border:0;">NEW POST</span>
            <h1>Create New Post</h1>
            <p class="form-description">Write something interesting and share it with your readers.</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error"><%= error %></div>
            <% } %>

            <form action="/posts" method="POST">
                <div class="form-group">
                    <label for="title">Post Title</label>
                    <input type="text" id="title" name="title" placeholder="Give your post a title" required>
                </div>

                <div class="form-group">
                    <label for="author">Author</label>
                    <input type="text" id="author" name="author" placeholder="Enter your name" required>
                </div>

                <div class="form-group">
                    <label for="content">Content</label>
                    <textarea id="content" name="content" placeholder="Start writing your post..." required></textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Publish Post</button>
                    <a href="/" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </main>

    <footer class="footer">© 2026 CMS Blog</footer>
</body>
</html>
